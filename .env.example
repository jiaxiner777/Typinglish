# Shared runtime mode
NODE_ENV=development

# Backend API host/port
PORT=4177

# PostgreSQL database used by the API and import/seed scripts.
DATABASE_URL=postgres://typinglish_user:password@127.0.0.1:5432/typinglish

# Frontend origin(s) allowed to call the API.
CORS_ORIGIN=http://127.0.0.1:5173

# Frontend build-time API base URL.
# This should point at the backend service origin, not include /api/v1.
VITE_API_BASE_URL=http://127.0.0.1:4177

# Optional admin protection token.
# If set, admin requests must send it as x-admin-token.
ADMIN_TOKEN=
VITE_ADMIN_TOKEN=

# Temporary fallback user before real authentication is added.
DEMO_USER_ID=00000000-0000-4000-8000-000000000001
