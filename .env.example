# Shared runtime mode
NODE_ENV=development

# Backend API host/port
PORT=4177

# PostgreSQL database used by the API and import/seed scripts.
DATABASE_URL=postgres://typinglish_user:password@127.0.0.1:5432/typinglish

# Frontend origin(s) allowed to call the API.
CORS_ORIGIN=http://127.0.0.1:5173

# Optional frontend build-time API base URL for local development.
# Leave unset in production: the web app and API use the same origin.
VITE_API_BASE_URL=http://127.0.0.1:4177

# Owner-only management key. Generate a random value of at least 32 characters.
# Required in production. Without it, the admin API stays disabled locally.
# Enter it on /admin; NEVER put it in a VITE_* variable or source control.
ADMIN_TOKEN=
