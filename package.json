{
  "name": "typinglish",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0 <23"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:client": "vite --host 127.0.0.1",
    "dev:server": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "build": "npm run check && npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node --env-file-if-exists=.env build/server/index.js",
    "start:production": "npm run db:bootstrap && npm start",
    "db:bootstrap": "node --env-file-if-exists=.env build/server/scripts/bootstrap.js",
    "api": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "import:srt": "node --env-file-if-exists=.env --import tsx server/scripts/import-srt.ts",
    "seed:demo": "node --env-file-if-exists=.env --import tsx server/scripts/seed-demo.ts",
    "backfill:adventure": "node --env-file-if-exists=.env --import tsx server/scripts/backfill-adventure-metadata.ts",
    "check": "tsc -b && tsc -p tsconfig.server.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "framer-motion": "^12.23.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.0"
  }
}
