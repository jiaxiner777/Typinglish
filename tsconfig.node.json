{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "outDir": "./build/tsconfig-node",
    "tsBuildInfoFile": "./build/.tsbuildinfo.node"
  },
  "include": ["vite.config.ts"]
}
